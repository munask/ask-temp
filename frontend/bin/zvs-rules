#!/usr/bin/env node

const fs = require('fs');
const path = require('path');

const RULES_DIR = '.ai-rules';
const RULES_FILE = 'rules.md';
const TARGETS = {
  cursor: {
    detect: () => fs.existsSync(path.resolve('.cursor')),
    target: path.resolve('.cursor', 'rules', 'standards.md'),
    label: 'Cursor (.cursor/rules/standards.md)',
  },
  copilot: {
    detect: () => fs.existsSync(path.resolve('.github')) || fs.existsSync(path.resolve('.vscode')),
    target: path.resolve('.github', 'copilot-instructions.md'),
    label: 'Copilot (.github/copilot-instructions.md)',
  },
  claude: {
    detect: () => true, // Claude works with just a file in root
    target: path.resolve('CLAUDE.md'),
    label: 'Claude Code (CLAUDE.md)',
  },
};

function getSourcePath() {
  return path.resolve(RULES_DIR, RULES_FILE);
}

function detectTools() {
  const detected = [];
  for (const [name, config] of Object.entries(TARGETS)) {
    if (config.detect()) {
      detected.push(name);
    }
  }
  return detected;
}

function syncRules(tools) {
  const source = getSourcePath();
  if (!fs.existsSync(source)) {
    console.error(`Error: Rules source not found at ${RULES_DIR}/${RULES_FILE}`);
    console.error(`Run "zvs-rules init" first or create ${RULES_DIR}/${RULES_FILE}`);
    process.exit(1);
  }

  const content = fs.readFileSync(source, 'utf8');
  const targets = tools || Object.keys(TARGETS);
  let synced = 0;

  for (const tool of targets) {
    const config = TARGETS[tool];
    if (!config) {
      console.error(`  Unknown tool: ${tool}`);
      continue;
    }

    const dir = path.dirname(config.target);
    fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(config.target, content);
    console.log(`  ${config.label}`);
    synced++;
  }

  return synced;
}

function showStatus() {
  const source = getSourcePath();
  console.log('\n  zvs-rules status\n');
  console.log('  Source:');

  if (fs.existsSync(source)) {
    const stats = fs.statSync(source);
    console.log(`    ${RULES_DIR}/${RULES_FILE} (${stats.size} bytes, ${stats.mtime.toISOString().split('T')[0]})`);
  } else {
    console.log(`    ${RULES_DIR}/${RULES_FILE} - NOT FOUND`);
  }

  console.log('\n  Targets:');

  for (const [name, config] of Object.entries(TARGETS)) {
    const exists = fs.existsSync(config.target);
    const icon = exists ? 'synced' : 'not synced';
    console.log(`    ${config.label} - ${icon}`);
  }

  console.log('');
}

function initRules() {
  const rulesDir = path.resolve(RULES_DIR);
  const rulesFile = path.resolve(RULES_DIR, RULES_FILE);

  // Create .ai-rules directory and default rules if missing
  if (!fs.existsSync(rulesFile)) {
    fs.mkdirSync(rulesDir, { recursive: true });
    const defaultRules = `# AI Coding Rules

## Template UI - Ask Before API Changes

When working on frontend/template UI:
- Before creating, modifying, or redesigning any API endpoint, ASK the user:
  "Do you have access to the backend? Should I suggest API changes or work with the existing API as-is?"
- If user confirms backend access: propose API improvements (naming, structure, response format)
- If no backend access: work only with the existing API contract, do not assume or suggest changes
- Never silently change API calls or data structures without asking first

## Project Structure

- Keep files under 600 lines. Maximum 900 lines. If exceeded, split into smaller modules
- Group related files together (component + styles + tests in same folder)
- Use index.ts re-exports for clean imports
- One concern per file, do not mix unrelated logic
- Delete unused files, do not comment them out

## Coding Standards

- TypeScript: strict mode, no \`any\` type
- Use const over let, prefer readonly
- Naming: camelCase for variables/functions, PascalCase for classes/types/interfaces, kebab-case for file names
- Import order: external packages first, then internal modules, then relative imports
- Error handling: always catch, never swallow errors silently
- No console.log in production code, use proper logging
- Use early returns to reduce nesting

## Fix Issues Properly

- Fix the root cause, do not add @ts-ignore or workaround hacks
- If a fix requires changing multiple files, do it properly across all files
- Clean up deprecated code when encountered
- Report issues you cannot fix rather than leaving them broken silently
`;
    fs.writeFileSync(rulesFile, defaultRules);
    console.log(`  Created ${RULES_DIR}/${RULES_FILE} with default rules`);
  } else {
    console.log(`  Found existing ${RULES_DIR}/${RULES_FILE}`);
  }

  // Detect tools
  const tools = detectTools();
  console.log('\n  Detected tools:');
  for (const tool of tools) {
    console.log(`    ${TARGETS[tool].label}`);
  }

  // Sync rules to all detected tools
  console.log('\n  Installing rules...');
  const synced = syncRules(tools);
  console.log(`\n  Done! Rules synced to ${synced} tools.`);
  console.log(`  Edit ${RULES_DIR}/${RULES_FILE} and run "zvs-rules sync" to update all tools.\n`);
}

// Main
const command = process.argv[2];

switch (command) {
  case 'init':
    initRules();
    break;
  case 'sync':
    console.log('\n  Syncing rules...\n');
    const tools = detectTools();
    const synced = syncRules(tools);
    console.log(`\n  Done! Rules synced to ${synced} tools.\n`);
    break;
  case 'status':
    showStatus();
    break;
  default:
    console.log(`
  zvs-rules - AI coding rules manager

  Usage:
    zvs-rules init      Detect tools and install rules
    zvs-rules sync      Re-sync rules after editing .ai-rules/rules.md
    zvs-rules status    Show which tools are detected and rules status

  Options:
    --help              Show this help message
`);
    break;
}
